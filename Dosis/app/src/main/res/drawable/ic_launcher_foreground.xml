        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M82,76 L82,70" />

    <!-- Manecilla de minuto del reloj -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M82,76 L87,76" />

    <!-- Centro del reloj -->
    <path
        android:fillColor="#FFFFFF"
