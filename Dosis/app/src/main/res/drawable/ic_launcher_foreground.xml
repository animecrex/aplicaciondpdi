        android:fillColor="#2E7D32"
        android:strokeColor="#2E7D32"
        android:strokeWidth="2"
        android:pathData="M54,30 L54,78" />

    <!-- Contorno de la pastilla -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
